# =============================================================================
# EPT Support Hub — variables d'environnement
# Copier en .env :   cp .env.example .env
# Ne JAMAIS committer le fichier .env. Les valeurs ci-dessous sont des valeurs
# de DÉVELOPPEMENT uniquement.
# =============================================================================

# --- Profil ------------------------------------------------------------------
# dev  : login rapide par compte de seed, Swagger, logs verbeux
# prod : Google OAuth uniquement, pas de Swagger
SPRING_PROFILES_ACTIVE=dev

# --- Base de données (PostgreSQL 16 + pgvector) --------------------------------
POSTGRES_DB=supporthub
POSTGRES_USER=supporthub
POSTGRES_PASSWORD=supporthub
# Port exposé sur la machine hôte (dev uniquement ; jamais exposé en prod)
POSTGRES_PORT=5432

# --- Backend -------------------------------------------------------------------
BACKEND_PORT=8080
# URL publique du frontend (redirections OAuth, liens dans les emails, CORS)
APP_FRONTEND_URL=http://localhost:5173

# Secret de signature des JWT (HS256, >= 32 caractères).
# Générer en prod : openssl rand -base64 48
APP_JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
# Durées de vie
APP_JWT_ACCESS_TTL=PT15M
APP_JWT_REFRESH_TTL=P7D

# Uploads (pièces jointes)
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=25MB

# --- Google OAuth 2.0 (voir docs/setup-google-oauth.md) ------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domaine Google Workspace autorisé (claim "hd" + domaine de l'email, vérifiés côté serveur)
APP_ALLOWED_DOMAIN=ept.sn

# --- Email (Mailpit en dev : http://localhost:8025) -----------------------------
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=support-hub@ept.sn
MAILPIT_UI_PORT=8025

# --- WhatsApp Cloud API (voir docs/setup-whatsapp.md) --------------------------
# false => adapter de log (aucun message réellement envoyé)
APP_WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Service IA (interne, jamais exposé publiquement en prod) ------------------
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_PORT=8000
# Jeton partagé backend <-> service IA (en-tête X-Internal-Token)
AI_INTERNAL_TOKEN=change-me-dev-only
# Délai max d'appel à l'IA avant repli sur la file manuelle
AI_TIMEOUT=PT2S

# --- Frontend ------------------------------------------------------------------
FRONTEND_PORT=5173
